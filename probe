Обработка массива
*/

void inputArray(int array[], int size);
void printArray(const int array[], int size);
int findMin(const int array[], int size);
int findMax(const int array[], int size);
int findMinIndex(const int array[], int size);
int findMaxIndex(const int array[], int size);
long long calculateSum(const int array[], int size);
double calculateAverage(const int array[], int size);
void countSigns(const int array[], int size, int *pos, int *neg, int *zero);
void countParity(const int array[], int size, int *even, int *odd);
void printInRange(const int array[], int size, int a, int b);
void moveNegativesFirst(int array[], int size);
void performIndividualTask(int array[], int size);
int count = 0;

int main(void)
{
    int array[MAX_SIZE];
    int size;

    printf("Введите размер массива от 1 до %d: ", MAX_SIZE);
    if (scanf("%d", &size) != 1 || size < 1 || size > MAX_SIZE) {
        printf("Ошибка: недопустимый размер массива.\n");
        return 1;
    }

    inputArray(array, size);

    printf("\nИсходный массив:\n");
    printArray(array, size);

    int minVal = findMin(array, size);
    int maxVal = findMax(array, size);
    int minIdx = findMinIndex(array, size);
    int maxIdx = findMaxIndex(array, size);
    long long sum = calculateSum(array, size);
    double avg = calculateAverage(array, size);

    printf("\nМинимум: %d (первый индекс: %d)\n", minVal, minIdx);
    printf("Максимум: %d (первый индекс: %d)\n", maxVal, maxIdx);
    printf("Сумма элементов: %lld\n", sum);
    printf("Среднее арифметическое: %.2f\n", avg);

    int pos, neg, zero;
    countSigns(array, size, &pos, &neg, &zero);
    printf("Положительных: %d, отрицательных: %d, нулевых: %d\n",
           pos, neg, zero);

    int even, odd;
    countParity(array, size, &even, &odd);
    printf("Чётных: %d, нечётных: %d\n", even, odd);

    int a, b;
    printf("\nВведите границы диапазона [a, b]: ");
    if (scanf("%d %d", &a, &b) != 2) {
        printf("Ошибка: неверный ввод границ.\n");
        return 1;
    }
    if (a > b) {
        int tmp = a;
        a = b;
        b = tmp;
    }
    printf("Элементы в диапазоне [%d, %d]: ", a, b);
    printInRange(array, size, a, b);
    printf("\n");

    performIndividualTask(array, size);

    return 0;
}

//Ввод массива
void inputArray(int array[], int size) {
    printf("Введите %d целых чисел:\n", size);
    for (int i = 0; i < size; i++) {
        while (scanf("%d", &array[i]) != 1) {
            printf("Ошибка ввода. Повторите ввод элемента %d: ", i + 1);
            while (getchar() != '\n') {  }
        }
    }
}

//Вывод массива
void printArray(const int array[], int size) {
    for (int i = 0; i < size; i++) {
        printf("%d", array[i]);
        if (i != size - 1) {
            printf(" ");
        }
    }
    printf("\n");
}

//Минимальное значение в массиве
int findMin(const int array[], int size) {
    int min = array[0];
    for (int i = 1; i < size; i++) {
        if (array[i] < min) {
            min = array[i];
        }
    }
    return min;
}

//Максимальное значение в массиве
int findMax(const int array[], int size) {
    int max = array[0];
    for (int i = 1; i < size; i++) {
        if (array[i] > max) {
            max = array[i];
        }
    }
    return max;
}

//Минимальный индекс в массиве
int findMinIndex(const int array[], int size) {
    int idx = 0;
    for (int i = 1; i < size; i++) {
        if (array[i] < array[idx]) {
            idx = i;
        }
    }
    return idx;
}

//Максимальный индекс в массиве
int findMaxIndex(const int array[], int size) {
    int idx = 0;
    for (int i = 1; i < size; i++) {
        if (array[i] > array[idx]) {
            idx = i;
        }
    }
    return idx;
}

//Сумма
long long calculateSum(const int array[], int size) {
    long long sum = 0;
    for (int i = 0; i < size; i++) {
        sum += array[i];
    }
    return sum;
}

//Среднее арифметическое
double calculateAverage(const int array[], int size) {
    return (double)calculateSum(array, size) / size;
}

//Положительные, орицатальные или нули
void countSigns(const int array[], int size, int *pos, int *neg, int *zero) {
    *pos = *neg = *zero = 0;
    for (int i = 0; i < size; i++) {
        if (array[i] > 0) {
            (*pos)++;
        } else if (array[i] < 0) {
            (*neg)++;
        } else {
            (*zero)++;
        }
    }
}

//Чётные и нечётные
void countParity(const int array[], int size, int *even, int *odd) {
    *even = *odd = 0;
    for (int i = 0; i < size; i++) {
        if (array[i] % 2 == 0) {
            (*even)++;
        } else {
            (*odd)++;
        }
    }
}

//Числа в диапазоне
void printInRange(const int array[], int size, int a, int b) {
    int found = 0;
    for (int i = 0; i < size; i++) {
        if (array[i] >= a && array[i] <= b) {
            printf("%d ", array[i]);
            found = 1;
        }
    }
    if (!found) {
        printf("(нет элементов)");
    }
}

//Удаление повторений
void deletesimilarities(int array[], int size) {
    int check = 0;
    for (int i = 0; i<size; i++) {
        check = array[i];
        int pos = i;
        int cnt = 0;
        for (int i = 0; i<size; i++) {
            if (check == array[i]){
                cnt += 1;
            }
        }
        if (cnt>1) {
            int d = 0;
            d = cnt - 1;
            count = cnt;
            for (int c = pos; c < size - d; c++){
            array[c] = array[c+1];                
            }
            
        }
    }
}

//Вывод результата
void performIndividualTask(int array[], int size) {
    printf("Массив до перестановки:\n");
    printArray(array, size);

    deletesimilarities(array, size);

    printf("Удаление повторений:\n");
    //Вывод нового массива
    int d = count - 1;
    for (int c = 0; c < size - d; c++){
                printf("%d ", array[c]);
            }
}
